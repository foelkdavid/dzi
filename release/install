#!/bin/sh
# Install this dzi release for the current user: ~/.local/bin/dzi, desktop launcher, icon, license notices.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
data=${XDG_DATA_HOME:-$HOME/.local/share}
case $data in /*) ;; *) echo "XDG_DATA_HOME must be absolute" >&2; exit 1 ;; esac
bin=$HOME/.local/bin
mkdir -p "$bin" "$data/applications" "$data/icons/hicolor/scalable/apps" "$data/dzi/licenses"
# Replace the file (new inode) so reinstalling works while dzi is running.
cp "$here/dzi" "$bin/.dzi-new" && chmod 755 "$bin/.dzi-new" && mv -f "$bin/.dzi-new" "$bin/dzi"
cp "$here/licenses/FONT-OFL.txt" "$here/licenses/RAYLIB-LICENSE.txt" "$here/licenses/BMU-LICENSE.txt" "$data/dzi/licenses/"
exec_path=$(printf '%s' "$bin/dzi" | sed 's/[\\"`$]/\\&/g; s/%/%%/g')
sed "s|^Exec=.*|Exec=\"$exec_path\" %f|" "$here/dzi.desktop" > "$data/applications/dzi.desktop"
cp "$here/dzi.svg" "$data/icons/hicolor/scalable/apps/dzi.svg"
command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database "$data/applications" >/dev/null 2>&1 || true
[ -f "$data/icons/hicolor/icon-theme.cache" ] && command -v gtk-update-icon-cache >/dev/null 2>&1 && gtk-update-icon-cache -q -t "$data/icons/hicolor" || true
echo "Installed $bin/dzi, $data/applications/dzi.desktop and the icon."
case ":$PATH:" in *":$bin:"*) ;; *) echo "Add ~/.local/bin to PATH to run dzi from a terminal." ;; esac
