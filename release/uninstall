#!/bin/sh
# Remove what ./install put in place (other files in those folders are kept).
set -eu
data=${XDG_DATA_HOME:-$HOME/.local/share}
rm -f "$HOME/.local/bin/dzi" "$data/applications/dzi.desktop" "$data/icons/hicolor/scalable/apps/dzi.svg" \
	"$data/dzi/licenses/FONT-OFL.txt" "$data/dzi/licenses/RAYLIB-LICENSE.txt"
rmdir "$data/dzi/licenses" "$data/dzi" 2>/dev/null || true
command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database "$data/applications" >/dev/null 2>&1 || true
[ -f "$data/icons/hicolor/icon-theme.cache" ] && command -v gtk-update-icon-cache >/dev/null 2>&1 && gtk-update-icon-cache -q -t "$data/icons/hicolor" || true
echo "Uninstalled dzi (settings in ~/.config/dzi are kept)."
